    "objectives": [
      {
        "level": "Primary Objective",
        "text": "To demonstrate that 3 mg LY900018 is non-inferior to 1 mg IMG for the proportion of patients achieving treatment success from insulin-induced hypoglycemia using a non-inferiority margin of 10%",
        "endpoints": [
          {
            "id": "Endpoint_1",
            "level": "Primary Endpoint",
            "text": "The proportion of patients achieving treatment success defined as either an increase in PG to >70 mg/dL or an increase of >20 mg/dL from nadir within 30 minutes after administration of glucagon. The nadir is defined as the minimum PG value at the time of or within 10 minutes following glucagon administration."
          }
        ]
      },
      {
        "level": "Secondary Objective",
        "text": "To compare the safety and tolerability of 3 mg LY900018 with 1 mg IMG",
        "endpoints": [
          {
            "id": "Endpoint_2",
            "level": "Secondary Endpoint",
            "text": "SAE, TEAEs (including gastrointestinal, nasal, and non-nasal AEs), vital signs"
          }
        ]
      },
      {
        "level": "Secondary Objective",
        "text": "To characterize the PK profile of 3 mg LY900018 compared to 1 mg IMG",
        "endpoints": [
          {
            "id": "Endpoint_3",
            "level": "Secondary Endpoint",
            "text": "PK parameters include AUC, Cmax, Tmax"
          }
        ]
      },
      {
        "level": "Secondary Objective",
        "text": "To characterize the PD profile of 3 mg LY900018 compared to 1 mg IMG",
        "endpoints": [
          {
            "id": "Endpoint_4",
            "level": "Secondary Endpoint",
            "text": "PD parameters include BGmax and Tmax"
          }
        ]
      },
      {
        "level": "Exploratory Objective",
        "text": "Explore the formation of anti-glucagon antibodies to glucagon",
        "endpoints": [
          {
            "id": "Endpoint_5",
            "level": "Exploratory Endpoint",
            "text": "Presence of anti-glucagon antibodies"
          }
        ]
      },
      {
        "level": "Exploratory Objective",
        "text": "To evaluate the recovery from clinical symptoms of hypoglycemia",
        "endpoints": [
          {
            "id": "Endpoint_6",
            "level": "Exploratory Endpoint",
            "text": "Hypoglycemia symptoms questionnaire"
          }
        ]
      }
    ],
