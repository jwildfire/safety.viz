    "time-to-event": {
      "export": "timeToEvent",
      "title": "Time-to-Event Explorer",
      "domains": ["ae", "subject"],
      "settings": {
        "id_col": {
          "domain": ["ae", "subject"],
          "column": "USUBJID",
          "required": false
        },
        "group_col": {
          "domain": "subject",
          "column": "ARM",
          "required": false
        },
        "fu_day_col": {
          "domain": "subject",
          "column": "EOSDY",
