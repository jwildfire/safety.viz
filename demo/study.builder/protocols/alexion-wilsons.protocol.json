    "objectives": [
      {
        "level": "Primary Objective",
        "text": "Assess net copper balance with daily repeat-dose ALXN1840 treatment (15 mg and 30 mg) in participants with Wilson disease (WD)",
        "endpoints": [
          {
            "id": "Endpoint_1",
            "level": "Primary Endpoint",
            "text": "Mean daily copper balance where copper balance is measured by the calculated difference between copper intake (in food and drink) and copper output (in feces and urine) during ALXN1840 accumulation and steady-state periods for each dose"
          }
        ]
      },
      {
        "level": "Secondary Objective",
        "text": "Assess change in copper balance in response to ALXN1840 15 mg/day and 30 mg/day during ALXN1840 accumulation and at steady state periods versus the pretreatment baseline in participants with WD",
        "endpoints": [
          {
            "id": "Endpoint_2",
            "level": "Secondary Endpoint",
            "text": "Change in mean daily copper balance as measured by the calculated difference between copper intake (in food and drink) and copper output (in feces and urine) from pretreatment baseline (Days -4 through -1) and ALXN1840 accumulation and steady-state periods for each dose"
          }
        ]
      },
      {
        "level": "Secondary Objective",
        "text": "Investigate the effect of ALXN1840 (15 mg/day and 30 mg/day) on the disposition of copper in participants with WD",
        "endpoints": [
          {
            "id": "Endpoint_3",
            "level": "Secondary Endpoint",
            "text": "Copper quantified in food, drink, feces, and urine, including plasma total and labile bound copper (LBC) during ALXN1840 accumulation and steady-state periods for each dose"
          }
        ]
      },
      {
        "level": "Secondary Objective",
        "text": "Investigate the effect of ALXN1840 on the disposition of molybdenum at steady state at 15 mg/day and 30 mg/day in participants with WD",
        "endpoints": [
          {
            "id": "Endpoint_4",
            "level": "Secondary Endpoint",
            "text": "Molybdenum quantified in food, drink, feces, and urine, plasma total molybdenum at ALXN1840 steady state"
          }
        ]
      },
      {
        "level": "Secondary Objective",
        "text": "Assess steady-state total molybdenum balance as a measure of ALXN1840 15 mg/day and 30 mg/day in participants with WD",
        "endpoints": [
          {
            "id": "Endpoint_5",
            "level": "Secondary Endpoint",
            "text": "Mean daily molybdenum balance as demonstrated through measurement of molybdenum intake (in food, drink and ALXN1840), and molybdenum output (feces and urine) representing ALXN1840 steady state"
          }
        ]
      },
      {
        "level": "Secondary Objective",
        "text": "Assess accumulation of molybdenum with ALXN1840 treatment at 15 mg/day and 30 mg/day in participants with WD",
        "endpoints": [
          {
            "id": "Endpoint_6",
            "level": "Secondary Endpoint",
            "text": "Accumulation of molybdenum as determined by molybdenum balance"
          }
        ]
      },
      {
        "level": "Secondary Objective",
        "text": "Determine the steady-state plasma pharmacokinetic (PK) of total molybdenum and plasma ultrafiltrate (PUF) molybdenum (as surrogate measures of ALXN1840, 15 mg and 30 mg) in participants with WD",
        "endpoints": [
          {
            "id": "Endpoint_7",
            "level": "Secondary Endpoint",
            "text": "PK parameters for plasma total and PUF-molybdenum"
          }
        ]
      },
      {
        "level": "Secondary Objective",
        "text": "Evaluate the safety and tolerability of repeated-dose administration of ALXN1840 15 mg/day and 30 mg/day in participants with WD",
        "endpoints": [
          {
            "id": "Endpoint_8",
            "level": "Secondary Endpoint",
            "text": "Treatment emergent adverse events (TEAEs)/serious adverse events (SAEs) Clinical laboratory assessments (serum chemistry, hematology, coagulation, and urinalysis) Physical examinations Heart rate, intervals (PR, QRS, QT and QTc), and clinically significant electrocardiogram (ECG) findings as determined by triplicate 12-lead ECG Vital sign assessments (blood pressure and heart rate)"
          }
        ]
      },
      {
        "level": "Exploratory Objective",
        "text": "Determine dose response of ALXN1840 15 mg/day and 30 mg/day for copper balance in participants with WD",
        "endpoints": [
          {
            "id": "Endpoint_9",
            "level": "Exploratory Endpoint",
            "text": "Assess dose response of ALXN1840 on copper balance focusing on copper balance"
          }
        ]
      },
      {
        "level": "Exploratory Objective",
        "text": "Determine the effect of treatment duration on copper balance in participants with WD",
        "endpoints": [
          {
            "id": "Endpoint_10",
            "level": "Exploratory Endpoint",
            "text": "Determine the effect of time following initiation of ALXN1840 treatment on copper balance"
          }
        ]
      },
      {
        "level": "Exploratory Objective",
        "text": "Assess the effects of ALXN1840 on ceruloplasmin, ceruloplasmin-bound copper LBC profiles in plasma in participants with WD",
        "endpoints": [
          {
            "id": "Endpoint_11",
            "level": "Exploratory Endpoint",
            "text": "Ceruloplasmin, ceruloplasmin-bound copper, and LBC: Change in ceruloplasmin at Days 1, 8, 25, 29, 36, and Day 39 compared with predose"
          }
        ]
      },
      {
        "level": "Exploratory Objective",
        "text": "Assess dose proportionality at steady state of doses of ALXN1840 15 mg/day and 30 mg/day in participants with WD",
        "endpoints": [
          {
            "id": "Endpoint_12",
            "level": "Exploratory Endpoint",
            "text": "Based on PK parameters"
          }
        ]
      },
      {
        "level": "Exploratory Objective",
        "text": "Assess effects ALXN1840 on copper:molybdenum ratio in plasma at steady state in participants with WD",
        "endpoints": [
          {
            "id": "Endpoint_13",
            "level": "Exploratory Endpoint",
            "text": "Measure plasma copper:molybdenum ratios at steady state compared with predose"
          }
        ]
      },
      {
        "level": "Exploratory Objective",
        "text": "Assess the effects of repeat-dose ALXN1840 on copper:molybdenum ratio in urine and feces in participants with WD",
        "endpoints": [
          {
            "id": "Endpoint_14",
            "level": "Exploratory Endpoint",
            "text": "Mean daily copper:molybdenum ratio in urine and feces at steady state compared with predose baseline"
          }
        ]
      }
    ],
